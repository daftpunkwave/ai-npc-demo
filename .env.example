# 部署参数（仅两个本地监听）
NPC_SERVER_HOST=127.0.0.1
NPC_SERVER_PORT=3000
NPC_CLIENT_PORT=5173
NPC_DATA_DIR=./data
# 控制台构建产物目录；相对路径按仓库根解析，缺省为 apps/server/console-static。
NPC_CONSOLE_STATIC_DIR=apps/server/console-static
NPC_LOG_LEVEL=info
# 冻结 manifest 的能力闭包发生变化后，设为 1 可迁移在线运行。
NPC_MIGRATE_ONLINE_RUN=0

# 在线世界的运行时选择
NPC_ASSEMBLY=local-slg-standard-v1
NPC_MODEL_LAYOUT=shared-model-layout-v1
NPC_ROSTER=standard-15

# 本地登录令牌；留空时自动生成并只打印一次
NPC_PLAYER_TOKEN=
NPC_CONSOLE_TOKEN=
# 可选的单角色控制台令牌
NPC_OPERATOR_TOKEN=
NPC_RESEARCHER_TOKEN=
NPC_EVALUATOR_TOKEN=

# 标准运行使用的 OpenAI 兼容供应商；回环地址允许空 API key。
# 值需写到 OpenAI 兼容基址（含 /v1），传输层在其后拼 chat/completions。
NPC_OPENAI_COMPAT_BASE_URL=https://api.deepseek.com/v1
NPC_OPENAI_COMPAT_API_KEY=
NPC_OPENAI_COMPAT_MODEL=deepseek-flash

# Anthropic Claude；由 credentialRef env:ANTHROPIC_API_KEY 读取。
ANTHROPIC_API_KEY=
