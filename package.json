{
  "name": "ai-npc-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.browser.json",
    "test": "vitest run",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check": "pnpm typecheck && pnpm test && pnpm check:boundaries && pnpm check:docs"
  },
  "devDependencies": {
    "@types/node": "^26",
    "tsx": "^4",
    "typescript": "^7",
    "vitest": "^5"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8"
  }
}
