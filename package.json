{
    "name": "world-prism",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.21.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.browser.json",
        "test": "vitest run",
        "check:docs": "tsx scripts/check-docs.ts",
        "check:boundaries": "tsx scripts/check-boundaries.ts",
        "check:catalog": "tsx scripts/check-catalog.ts",
        "dev:server": "tsx apps/server/src/main.ts",
        "dev:client": "vite apps/client --config apps/client/vite.config.ts",
        "dev": "tsx scripts/dev.ts",
        "build": "vite build apps/client --config apps/client/vite.config.ts && vite build apps/console --config apps/console/vite.config.ts",
        "start": "tsx scripts/start.ts",
        "test:e2e": "playwright test",
        "check:ports": "tsx scripts/check-ports.ts",
        "check": "pnpm typecheck && pnpm test && pnpm check:boundaries && pnpm check:catalog && pnpm check:assets && pnpm check:docs",
        "check:assets": "tsx scripts/check-assets.ts",
        "measure:model-evidence": "tsx scripts/measure-model-evidence.ts"
    },
    "devDependencies": {
        "@world-prism/app-server": "workspace:*",
        "@world-prism/contracts": "workspace:*",
        "@types/node": "^26",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@playwright/test": "^1",
        "tsx": "^4",
        "typescript": "^7",
        "vite": "^8",
        "vitest": "^5"
    }
}
